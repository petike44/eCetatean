# Supabase — get from supabase.com project dashboard → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Supabase JWT secret — Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# Frontend URL — must match the port Vite prints (often :8080 or :5173)
# In dev, CORS also allows localhost:8080 and :5173 automatically
FRONTEND_URL=http://localhost:8080

# EidKit SSO / Romanian electronic ID verification.
# Get client credentials from https://dashboard.eidkit.ro after registering
# the app with a real CEI card. Until then, leave ID/secret empty and use
# the demo verification button in local development.
EIDKIT_ISSUER=https://idp.eidkit.ro
EIDKIT_CLIENT_ID=
EIDKIT_CLIENT_SECRET=
EIDKIT_REDIRECT_URI=http://localhost:3001/api/eidkit/callback
EIDKIT_SCOPES=openid profile address cei:cnp cei:document
EIDKIT_ENABLE_DEMO=true

# Google Gemini — ClaudIA (get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# WeTranslate partner handoff — optional until WeTranslate provides partner access.
# When empty, the app falls back to opening their public order form.
WETRANSLATE_API_URL=
WETRANSLATE_API_KEY=

# LibreTranslate demo API — optional. Leave URL empty to try public mirrors.
# For reliable demos, self-host with Docker on http://localhost:5000.
LIBRETRANSLATE_API_URL=
LIBRETRANSLATE_API_KEY=

# Local dev auth stub — set AUTH_STUB=true to bypass auth for local testing.
# Only use this if you have NOT set up Supabase credentials yet.
AUTH_STUB=false
AUTH_STUB_ROLE=citizen
AUTH_STUB_USER_ID=stub-user-citizen

# ─── Tipizatul.eu Drive proxy (Phase 3) ────────────────────────────
# Service-account credentials used to fetch PDF binaries from the public
# Google Drive folder backing tipizatul. Files are publicly shared, but
# the SA path is rate-limit-safe vs a bare API key. Create the SA in
# Google Cloud Console → IAM → Service Accounts, grant it the
# "drive.readonly" scope, and paste the email + private key (PEM, with
# real newlines preserved or escaped as \n) below.
GDRIVE_SA_EMAIL=
GDRIVE_SA_PRIVATE_KEY=
