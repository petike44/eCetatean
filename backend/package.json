{
  "name": "ecetatean-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:tipizatul": "tsx --env-file=.env.local scripts/sync-tipizatul-catalog.ts",
    "sync:tipizatul-procedures": "tsx --env-file=.env.local scripts/sync-tipizatul-procedures.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^2.0.3",
    "@pdfme/common": "^6.1.2",
    "@pdfme/generator": "^6.1.2",
    "@pdfme/pdf-lib": "^6.1.2",
    "@supabase/supabase-js": "^2.106.1",
    "hono": "^4.12.22",
    "jose": "^6.2.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
